package {{ .Options.package }}

import (
{{- range .Plugins }}
	"{{ .ImportPath }}"
{{- end }}
)

// Names lists every plugin, in name order.
var Names = []string{
{{- range .Plugins }}
	"{{ .Package }}", // {{ pluginTitle .Package }}
{{- end }}
}

// New returns a new instance of the plugin called name, or nil if there is none.
func New(name string) any {
	switch name {
{{- range .Plugins }}
	case "{{ .Package }}":
		return {{ .Package }}.New()
{{- end }}
	}
	return nil
}
