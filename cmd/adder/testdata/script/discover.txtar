# list shows every generator and derived output.
exec adder list
cmp stdout list.out
exec adder list --json
cmp stdout list.json

# describe shows a generator's inputs with the values the scans allow now.
exec adder describe driver
cmp stdout describe.out
exec adder describe driver --json
cmp stdout describe.json
exits 2 adder describe drivr
stderr 'did you mean driver\?'

# explain says where a generated file comes from, from any directory.
exec adder derive
exec adder explain drivers/drivers.gen.go
cmp stdout explain.out
cd drivers/s3
exec adder explain s3.go
stdout '^s3.go was not generated by adder.$'
cd $WORK

# A new driver makes the registry out of date, which explain reports too.
mkdir drivers/gcs
cp gcs.go drivers/gcs/gcs.go
exec adder explain drivers/drivers.gen.go --json
cmp stdout explain.json

-- list.out --
generators
  driver  Add a storage driver
outputs
  drivers/drivers.gen.go  from templates/drivers.go.tmpl
