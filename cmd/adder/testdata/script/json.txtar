{
  "warnings": [],
  "problems": [
    {
      "code": "unknown-generator",
      "message": "unknown generator \"drivr\"",
      "hint": "did you mean driver?"
    }
  ]
}
-- flag.json --
{
  "warnings": [],
  "problems": [
    {
      "code": "usage",
      "message": "unknown flag: --nope",
      "hint": "run 'adder check --help' for usage"
    }
  ]
}
-- command.json --
{
  "warnings": [],
  "problems": [
    {
      "code": "usage",
      "message": "unknown command \"nope\" for \"adder\"",
      "hint": "run 'adder --help' for usage"
    }
  ]
}
-- config.json --
{
  "dryRun": false,
  "changes": [],
  "warnings": [],
  "problems": [
    {
      "code": "missing-field",
      "message": "output 0: path is required",
      "pos": {
        "file": "adder.yaml",
        "line": 7,
        "column": 7
      }
