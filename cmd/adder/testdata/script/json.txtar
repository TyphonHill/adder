# derive lists every change, and nothing goes to standard error.
exec adder derive --json
cmp stdout derive.json
! stderr .

# A second run reports the output as unchanged.
exec adder derive --json --dry-run
cmp stdout unchanged.json

# check reports stale outputs with status 3 and no problems, and --diff adds each diff.
mkdir drivers/gcs
cp gcs.go drivers/gcs/gcs.go
exits 3 adder check --json --diff
cmp stdout stale.json
! stderr .

# new reports the generator, its changes, and its message, even on a dry run.
exec adder new driver --name blob --dry-run --json
cmp stdout new.json
! exists drivers/blob

# Problems keep their codes and positions, and exit statuses are unchanged.
exits 2 adder new driver --json
cmp stdout missing.json
! stderr .
exits 2 adder new drivr --json
cmp stdout unknown.json

# Usage mistakes become usage problems, even before --json is parsed.
exits 2 adder check --nope --json
cmp stdout flag.json
! stderr .
exits 2 adder nope --json
cmp stdout command.json

# --json=false turns it back off, and help is still text.
exec adder derive --json --json=false --dry-run
stdout '^would be updated    drivers/drivers.gen.go$'
exec adder --json --help
stdout '^Usage:$'

# Problems in adder.yaml are reported with their positions.
cp bad.yaml adder.yaml
exits 1 adder derive --json
cmp stdout config.json

# init reports the file it created, or the problem.
mkdir fresh
exec adder init --root fresh --json
cmp stdout init.json
exits 1 adder init --root fresh --json
stdout '"code": "file-exists"'

-- derive.json --
{
  "dryRun": false,
  "changes": [
    {
      "path": "drivers/drivers.gen.go",
      "status": "created"
    }
  ],
  "warnings": [],
  "problems": []
}
-- unchanged.json --
{
  "dryRun": true,
  "changes": [
    {
      "path": "drivers/drivers.gen.go",
      "status": "unchanged"
    }
  ],
  "warnings": [],
  "problems": []
}
-- stale.json --
{
  "changes": [
    {
      "path": "drivers/drivers.gen.go",
      "status": "updated",
      "diff": "diff a/drivers/drivers.gen.go b/drivers/drivers.gen.go\n--- a/drivers/drivers.gen.go\n+++ b/drivers/drivers.gen.go\n@@ -4,6 +4,7 @@\n \n import (\n \t\"example.com/storage/driver\"\n+\t\"example.com/storage/drivers/gcs\"\n \t\"example.com/storage/drivers/local\"\n \t\"example.com/storage/drivers/s3\"\n )\n@@ -10,6 +11,7 @@\n \n // All maps each driver name to its constructor.\n var All = map[string]driver.Factory{\n+\t\"gcs\":   gcs.New,\n \t\"local\": local.New,\n \t\"s3\":    s3.New,\n }\n"
    }
  ],
  "warnings": [],
  "problems": []
}
-- new.json --
{
  "generator": "driver",
  "dryRun": true,
  "changes": [
    {
      "path": "drivers/blob/blob.go",
      "status": "created"
    },
    {
      "path": "drivers/README.md",
      "status": "created"
    },
    {
      "path": "drivers/drivers.gen.go",
      "status": "updated"
    }
  ],
  "message": "Next, implement New in drivers/blob/blob.go.",
  "warnings": [],
  "problems": []
}
-- missing.json --
