  "generator": "driver",
  "dryRun": false,
  "changes": [],
  "message": "",
  "warnings": [],
  "problems": [
    {
      "code": "missing-input",
      "message": "--name is required",
      "hint": "Driver name, used as the package name"
    }
  ]
}
