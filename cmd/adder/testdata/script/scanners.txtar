# A repository's own scanner finds what no built-in scan can: here, routes listed in routes.txt files.
env GOPROXY=off
cp $ADDER_ROOT/go.mod go.mod
cp $ADDER_ROOT/go.sum go.sum
exec go mod edit -module=example.com/app -toolchain=none -require=typhonhill.dev/adder@v0.0.0 -replace=typhonhill.dev/adder=$ADDER_ROOT -tool=example.com/app/tools/adder
cp adder.yaml good.yaml
exec go tool adder derive
cmp api/routes.gen.go want/routes.gen.go
exists api/users/get_users.gen.go
exec go tool adder check -v
stdout '^scanned    scan Routes found 3 items$'

# unique reads the scanner's items, and a new file is scanned in the same run.
exits 2 go tool adder new service --name users --path /x
stderr 'already exists in Routes.service \[invalid-input\]'
exec go tool adder new service --name orders --path /orders
stdout '^created    api/orders/routes.txt$'
stdout '^updated    api/routes.gen.go$'
stdout '^created    api/orders/get_orders.gen.go$'
grep 'GET /v1/orders' api/routes.gen.go

# A Problem from the scanner points at the file, and other mistakes at adder.yaml.
cp bad.txt api/users/routes.txt
exits 1 go tool adder check
stderr '^api[/\\]users[/\\]routes.txt:2: want METHOD /path \[scanner\]$'
cp typo.yaml adder.yaml
exits 1 go tool adder check
stderr '^adder.yaml:4:62: unknown field "prefx" \[unknown-field\]$'

# The stock build does not have the scanner.
cp good.yaml adder.yaml
exits 1 adder check
stderr '^adder.yaml:6:17: scan "Routes": adder was built without scanner "routes" \[unknown-scanner\]$'

-- tools/adder/main.go --
package main

import (
	"context"
	"io/fs"
	"path"
	"strings"

	"typhonhill.dev/adder"
)

func main() {
	adder.Main(adder.Pack{Name: "local", Scanners: map[string]adder.Scanner{"routes": routes}})
}

// routes lists the routes in each directory's routes.txt, written "METHOD /path" one per line.
func routes(_ context.Context, in *adder.ScanInput) ([]any, error) {
	var opts struct {
		Prefix string `yaml:"prefix"`
	}
	if err := in.Decode(&opts); err != nil {
		return nil, err
	}
	var items []any
	for _, dir := range in.Dirs {
		file := path.Join(dir, "routes.txt")
		data, err := fs.ReadFile(in.FS, file)
		if err != nil {
			return nil, err
		}
		for i, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
			method, p, ok := strings.Cut(line, " ")
			if !ok {
				return nil, adder.Problem{File: file, Line: i + 1, Message: "want METHOD /path"}
			}
			items = append(items, map[string]any{
				"service": path.Base(dir),
				"method":  method,
				"path":    opts.Prefix + p,
				"name":    strings.ToLower(method) + strings.ReplaceAll(p, "/", "_"),
			})
		}
	}
	return items, nil
}
-- adder.yaml --
version: 1
derive:
  scans:
    Routes:
      dirs: ["api/*"]
      scanner: {name: routes, with: {prefix: /v1}}
  outputs:
    - {template: routes.go.tmpl, path: api/routes.gen.go}
    - {template: route.go.tmpl, each: Routes, path: "api/{{ .Item.service }}/{{ .Item.name }}.gen.go"}
generators:
  service:
    inputs:
      name: {pattern: "[a-z]+", unique: Routes.service}
      path: {pattern: "/[a-z]+"}
    files:
      - {template: routes.txt.tmpl, path: "api/{{ .Inputs.name }}/routes.txt"}
-- typo.yaml --
version: 1
derive:
  scans:
    Routes: {dirs: ["api/*"], scanner: {name: routes, with: {prefx: /v1}}}
  outputs:
    - {template: routes.go.tmpl, path: api/routes.gen.go}
-- routes.go.tmpl --
package api

// Routes:
{{- range sortBy "path" .Routes }}
// {{ .method }} {{ .path }}
{{- end }}
-- route.go.tmpl --
package {{ .Item.service }}

// {{ .Item.method }} {{ .Item.path }}
-- routes.txt.tmpl --
GET {{ .Inputs.path }}
-- api/users/routes.txt --
GET /users
POST /users
-- api/health/routes.txt --
GET /health
-- bad.txt --
GET /users
broken
-- want/routes.gen.go --
// Code generated by adder from routes.go.tmpl. DO NOT EDIT.

package api

// Routes:
// GET /v1/health
// GET /v1/users
// POST /v1/users
