# Every configuration at or below the directory runs, and the root's ** stops at the nested ones.
exec adder derive ./...
cmp stdout derive.out
grep '^- example.com/mono/tools$' cmds.md
! grep 'services' cmds.md
grep '^- example.com/api/h$' services/api/cmds.md

# With --json, each configuration has its own entry and problems.
exec adder check ./... --json
stdout '"config": "services/api/adder.yaml",'
stdout '"configs": \['

# A stale configuration makes check exit 3, with paths from the current directory, and --diff patches that apply.
cp w2.go services/web/w/w2.go
exits 3 adder check ./... --diff
stdout '^would be updated    services/web/cmds.md$'
stdout '^--- a/services/web/cmds.md$'
stderr '1 derived file is out of date'
exec adder check services/api
exec adder derive services/web

# A configuration with a problem fails the run, but the others still run.
cp broken.yaml services/web/adder.yaml
exits 1 adder derive ./... -v
stdout 'scan Cmds in services/api found 1 item'
stderr 'services[/\\]web[/\\]adder.yaml:2: unknown field "derivee"'
cp good.yaml services/web/adder.yaml

# list and test run over configurations too, and test still takes generator names.
exec adder list ./...
stdout '^services/api/adder.yaml$'
exec adder test ./... api
stdout '^no generator tests$'
exits 2 adder test ./... nope
stderr 'unknown generator "nope"'

# explain uses the configuration nearest the file.
exec adder explain services/api/cmds.md
stdout '^services/api/cmds.md is generated by adder.$'
stdout 'output    services[/\\]api[/\\]adder.yaml:'

# Patterns cannot be combined with --root, must name directories, and must match a configuration.
exits 2 adder check --root . ./...
stderr 'cannot be combined with directory patterns'
exits 2 adder check services
stderr '"services" is not a directory'
exits 1 adder check ./docs/...
stderr 'matches no adder.yaml'

-- derive.out --
created    cmds.md
created    services/api/cmds.md
created    services/web/cmds.md
-- go.mod --
module example.com/mono

go 1.26.0
-- adder.yaml --
version: 1
derive:
  scans:
    Cmds: {dirs: ["**"], funcs: {name: ^Run$}}
  outputs:
    - {template: list.tmpl, path: cmds.md}
-- list.tmpl --
{{ range .Cmds }}- {{ .ImportPath }}
{{ end -}}
-- tools/t.go --
package tools

func Run() {}
-- docs/README.md --
No configuration here.
-- services/api/adder.yaml --
version: 1
derive:
  scans:
    Cmds: {dirs: ["**"], funcs: {name: ^Run$}}
  outputs:
    - {template: list.tmpl, path: cmds.md}
generators:
  api:
    files:
      - {template: list.tmpl, path: x.md}
-- services/api/list.tmpl --
{{ range .Cmds }}- {{ .ImportPath }}
{{ end -}}
-- services/api/go.mod --
module example.com/api

go 1.26.0
-- services/api/h/h.go --
package h

func Run() {}
-- services/web/adder.yaml --
version: 1
derive:
  scans:
    Cmds: {dirs: ["**"], funcs: {name: ^Run$}}
  outputs:
    - {template: list.tmpl, path: cmds.md}
-- services/web/list.tmpl --
{{ range .Cmds }}- {{ .File }}
{{ end -}}
-- services/web/w/w.go --
package w

func Run() {}
-- w2.go --
package w2

func Run() {}
-- broken.yaml --
version: 1
derivee: {}
-- good.yaml --
version: 1
derive:
  scans:
    Cmds: {dirs: ["**"], funcs: {name: ^Run$}}
  outputs:
    - {template: list.tmpl, path: cmds.md}
