# A pack's derive outputs run once for each use, with its options and scans.
env GOPROXY=off
cp $ADDER_ROOT/go.mod go.mod
cp $ADDER_ROOT/go.sum go.sum
exec go mod edit -module=example.com/app -toolchain=none -require=github.com/TyphonHill/adder@v0.0.0 -replace=github.com/TyphonHill/adder=$ADDER_ROOT -tool=example.com/app/tools/adder
exec go tool adder derive
stdout '^created    drivers/registry.gen.go$'
stdout '^created    caches/registry.gen.go$'
cmp drivers/registry.gen.go want/drivers.gen.go
exec go tool adder check -v
stdout '^scanned    scan Impls for drivers found 2 items$'

# list and explain name the pack and the use.
exec go tool adder list
stdout '^  drivers/registry.gen.go  from registry.go.tmpl in pack store for drivers$'
exec go tool adder list --json
stdout '"pack": "store",\s+"use": "drivers"'
exec go tool adder explain drivers/registry.gen.go
stdout '^  output    pack store: pack.yaml:8:7$'
stdout '^  pack      store, used as drivers$'
stdout '^  status    up to date$'

# A mistake in a use is reported where the use gives the option.
cp bad.yaml adder.yaml
exits 1 go tool adder check
stderr '^adder.yaml:5:12: pack use "drivers": option "dirs" is "drivers/\*", want a list of strings \[invalid-value\]$'

# The stock build does not have the pack.
exits 1 adder check
stderr '^adder.yaml:4:5: pack use "drivers": adder was built without pack "store" \[unknown-pack\]$'

-- tools/adder/main.go --
package main

import (
	"github.com/TyphonHill/adder"

	"example.com/app/store"
)

func main() { adder.Main(store.Pack) }
-- store/pack.go --
// Package store is a pack that lists the implementations in a set of directories.
package store

import (
	"embed"

	"github.com/TyphonHill/adder"
)

//go:embed pack.yaml registry.go.tmpl
var files embed.FS

var Pack = adder.Pack{Name: "store", FS: files}
-- store/pack.yaml --
version: 1
options:
  dirs: {type: list, help: Directories that each hold one implementation}
derive:
  scans:
    Impls: {dirs: {option: dirs}, funcs: {name: ^New$}}
  outputs:
    - template: registry.go.tmpl
      path: "{{ index .Options.dirs 0 | trimSuffix \"/*\" }}/registry.gen.go"
-- store/registry.go.tmpl --
package registry

var names = []string{ {{- range .Impls }}"{{ .Package }}", {{ end -}} }
-- adder.yaml --
version: 1
packs:
  drivers:
    pack: store
    with: {dirs: ["drivers/*"]}
  caches:
    pack: store
    with: {dirs: ["caches/*"]}
-- bad.yaml --
version: 1
packs:
  drivers:
    pack: store
    with: {dirs: "drivers/*"}
-- drivers/disk/disk.go --
package disk

func New() {}
-- drivers/s3/s3.go --
package s3

func New() {}
-- caches/mem/mem.go --
package mem

func New() {}
-- want/drivers.gen.go --
// Code generated by adder from registry.go.tmpl in pack store for drivers. DO NOT EDIT.

package registry

var names = []string{"disk", "s3"}
