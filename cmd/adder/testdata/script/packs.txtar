# A pack's derive outputs run once for each use, with its options and scans.
env GOPROXY=off
cp $ADDER_ROOT/go.mod go.mod
cp $ADDER_ROOT/go.sum go.sum
exec go mod edit -module=example.com/app -toolchain=none -require=typhonhill.dev/adder@v0.0.0 -replace=typhonhill.dev/adder=$ADDER_ROOT -tool=example.com/app/tools/adder
exec go tool adder derive
stdout '^created    drivers/registry.gen.go$'
stdout '^created    caches/registry.gen.go$'
cmp drivers/registry.gen.go want/drivers.gen.go
exec go tool adder check -v
stdout '^scanned    scan Impls for drivers found 2 items$'

# list and explain name the pack and the use.
exec go tool adder list
stdout '^  drivers/registry.gen.go  from registry.go.tmpl in pack store for drivers$'
exec go tool adder list --json
stdout '"pack": "store",\s+"use": "drivers"'
exec go tool adder explain drivers/registry.gen.go
stdout '^  output    pack store: pack.yaml:8:7$'
stdout '^  pack      store, used as drivers$'
stdout '^  status    up to date$'

# The repository's own output renders the pack's template with the repository's scans.
cmp all/registry.gen.go want/all.gen.go
exec go tool adder explain all/registry.gen.go
stdout '^  output    adder.yaml:4:7$'
stdout '^  pack      store$'

# A pack's generators are commands, renamed per use, and their new files reach the use's registry in the same run.
exec go tool adder list
stdout '^  driver  Add an implementation \(pack store for drivers\)$'
stdout '^  cache   Add an implementation \(pack store for caches\)$'
exec go tool adder new driver --name gcs
stdout '^created    drivers/gcs/gcs.go$'
stdout '^updated    drivers/registry.gen.go$'
stdout '^Implement New in drivers/gcs/gcs.go.$'
grep '"disk", "gcs", "s3"' drivers/registry.gen.go
exec go tool adder check

# unique applies to the use's own scan.
exits 2 go tool adder new cache --name mem
stderr 'invalid-input'
exec go tool adder new cache --name disk
stdout '^created    caches/disk/disk.go$'

# A use tests its pack's generators against golden files in the repository.
exec go tool adder test
stdout '^ok    driver/plain$'

# A mistake in a use is reported where the use gives the option.
cp bad.yaml adder.yaml
exits 1 go tool adder check
stderr '^adder.yaml:5:12: pack use "drivers": option "dirs" is "drivers/\*", want a list of strings \[invalid-value\]$'

# The stock build does not have the pack.
exits 1 adder check
stderr '^adder.yaml:4:5: pack use "drivers": adder was built without pack "store" \[unknown-pack\]$'

-- tools/adder/main.go --
package main

import (
	"typhonhill.dev/adder"

	"example.com/app/store"
)

func main() { adder.Main(store.Pack) }
-- store/pack.go --
// Package store is a pack that lists the implementations in a set of directories.
package store

import (
	"embed"

	"typhonhill.dev/adder"
)

//go:embed pack.yaml registry.go.tmpl impl.go.tmpl
var files embed.FS

var Pack = adder.Pack{Name: "store", FS: files}
-- store/pack.yaml --
version: 1
options:
  dirs: {type: list, help: Directories that each hold one implementation}
derive:
  scans:
    Impls: {dirs: {option: dirs}, funcs: {name: ^New$}}
  outputs:
    - template: registry.go.tmpl
      path: "{{ index .Options.dirs 0 | trimSuffix \"/*\" }}/registry.gen.go"
generators:
  impl:
    description: Add an implementation
    inputs:
      name: {pattern: "[a-z][a-z0-9]*", unique: Impls.Package}
    files:
      - template: impl.go.tmpl
        path: "{{ index .Options.dirs 0 | trimSuffix \"/*\" }}/{{ .Inputs.name }}/{{ .Inputs.name }}.go"
    message: Implement New in {{ index .Options.dirs 0 | trimSuffix "/*" }}/{{ .Inputs.name }}/{{ .Inputs.name }}.go.
-- store/impl.go.tmpl --
package {{ .Inputs.name }}

func New() {}
-- store/registry.go.tmpl --
package registry

var names = []string{ {{- range .Impls }}"{{ .Package }}", {{ end -}} }
-- adder.yaml --
version: 1
derive:
  outputs:
    - {template: registry.go.tmpl, pack: store, path: all/registry.gen.go}
  scans:
    Impls: {dirs: ["drivers/*", "caches/*"], funcs: {name: ^New$}}
packs:
  drivers:
    pack: store
    with: {dirs: ["drivers/*"]}
    rename: {impl: driver}
    tests:
      driver: [{name: plain, inputs: {name: example}, want: testdata/driver}]
  caches:
    pack: store
    with: {dirs: ["caches/*"]}
    rename: {impl: cache}
-- testdata/driver/drivers/example/example.go --
package example

func New() {}
-- bad.yaml --
version: 1
packs:
  drivers:
    pack: store
    with: {dirs: "drivers/*"}
-- drivers/disk/disk.go --
package disk

func New() {}
-- drivers/s3/s3.go --
package s3

func New() {}
-- caches/mem/mem.go --
package mem

func New() {}
-- want/all.gen.go --
// Code generated by adder from registry.go.tmpl in pack store. DO NOT EDIT.

package registry

var names = []string{"mem", "disk", "s3"}
-- want/drivers.gen.go --
// Code generated by adder from registry.go.tmpl in pack store for drivers. DO NOT EDIT.

package registry

var names = []string{"disk", "s3"}
