# A file scan lists migrations, and an output with each renders one Go file per migration.
exec adder derive
cmp stdout derive.out
cmp db/0001_init.gen.go want/0001_init.gen.go
cmp db/migrations.gen.go want/migrations.gen.go

# A new migration gets its file and joins the list; a removed one's file is removed.
cp new.sql db/migrations/0003_orders.sql
rm db/migrations/0001_init.sql
exec adder derive
cmp stdout changed.out

-- adder.yaml --
version: 1
derive:
  scans:
    Migrations:
      dirs: [db/migrations]
      files: {name: '^[0-9]+_.*\.sql$'}
  outputs:
    - template: migration.go.tmpl
      each: Migrations
      path: "db/{{ trimSuffix \".sql\" .Item.Name }}.gen.go"
    - template: list.go.tmpl
      path: db/migrations.gen.go
-- go.mod --
module example.com/app

go 1.26.0
-- db/migrations/0001_init.sql --
CREATE SCHEMA app;
-- db/migrations/0002_users.sql --
CREATE TABLE users;
-- db/migrations/README.md --
Migrations run in name order.
-- new.sql --
CREATE TABLE orders;
-- migration.go.tmpl --
package db

func init() { register({{ quote .Item.Name }}) }
-- list.go.tmpl --
package db

// Migrations lists every migration in the order they run.
var Migrations = []string{
{{- range .Migrations }}
	{{ quote .File }},
{{- end }}
}
-- derive.out --
created    db/0001_init.gen.go
created    db/0002_users.gen.go
created    db/migrations.gen.go
-- changed.out --
created    db/0003_orders.gen.go
removed    db/0001_init.gen.go
updated    db/migrations.gen.go
-- want/0001_init.gen.go --
// Code generated by adder from migration.go.tmpl. DO NOT EDIT.

package db

func init() { register("0001_init.sql") }
-- want/migrations.gen.go --
// Code generated by adder from list.go.tmpl. DO NOT EDIT.

package db

// Migrations lists every migration in the order they run.
var Migrations = []string{
	"db/migrations/0001_init.sql",
	"db/migrations/0002_users.sql",
}
