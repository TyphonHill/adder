# Two unrelated repositories share a generator pack, published as a versioned module.
modproxy example.com/storepack@v1.0.0 pack

# Each repository requires what adder does and the pack. The pack is added with go mod edit and go mod download
# rather than go get, which reads every module in the graph, including some adder's own build never downloads.

# The first keeps stores under stores/.
cd repo-a
cp $ADDER_ROOT/go.mod go.mod
cp $ADDER_ROOT/go.sum go.sum
exec go mod edit -module=example.com/repo-a -toolchain=none -require=typhonhill.dev/adder@v0.0.0 -replace=typhonhill.dev/adder=$ADDER_ROOT -tool=example.com/repo-a/tools/adder
exec go mod edit -require=example.com/storepack@v1.0.0
exec go mod download example.com/storepack
exec go tool adder derive
cmp registry/registry.gen.go ../want/a-1.0.gen.go
exec go tool adder new store --name mem
stdout '^created    stores/mem/mem.go$'
stdout '^updated    registry/registry.gen.go$'
grep '^// New returns the Mem store.$' stores/mem/mem.go
exec go tool adder check

# The second keeps backends under internal/backends/, with its own names.
cd ../repo-b
cp $ADDER_ROOT/go.mod go.mod
cp $ADDER_ROOT/go.sum go.sum
exec go mod edit -module=example.com/repo-b -toolchain=none -require=typhonhill.dev/adder@v0.0.0 -replace=typhonhill.dev/adder=$ADDER_ROOT -tool=example.com/repo-b/tools/adder
exec go mod edit -require=example.com/storepack@v1.0.0
exec go mod download example.com/storepack
exec go tool adder new backend --name gcs
stdout '^created    internal/backends/gcs/gcs.go$'
stdout '^created    internal/registry/registry.gen.go$'
cmp internal/registry/registry.gen.go ../want/b-1.0.gen.go

# A new version of the pack reaches each repository when it upgrades, and not before.
cd $WORK
cp v1.1/registry.go.tmpl pack/templates/registry.go.tmpl
modproxy example.com/storepack@v1.1.0 pack
cd repo-a
exec go mod edit -require=example.com/storepack@v1.1.0
exec go mod download example.com/storepack
exits 3 go tool adder check
exec go tool adder derive
stdout '^updated    registry/registry.gen.go$'
cmp registry/registry.gen.go ../want/a-1.1.gen.go
cd ../repo-b
grep 'example.com/storepack v1.0.0' go.mod
exec go tool adder check

-- pack/go.mod --
module example.com/storepack

go 1.26.0

require typhonhill.dev/adder v0.0.0
-- pack/store.go --
// Package store is a pack for repositories that keep one store implementation per directory.
package store

import (
	"embed"
	"strings"

	"typhonhill.dev/adder"
)

//go:embed pack.yaml templates
var files embed.FS

// Pack registers every store in a registry, and adds new stores.
var Pack = adder.Pack{
	Name:  "store",
	FS:    files,
	Funcs: map[string]any{"storeTitle": func(s string) string { return strings.ToUpper(s[:1]) + s[1:] }},
}
-- pack/pack.yaml --
version: 1
options:
  dirs: {type: list, help: Directories that each hold one store}
  out: {help: Directory of the registry}
  package: {default: registry, help: Package name of the registry}
derive:
  scans:
    Stores: {dirs: {option: dirs}, funcs: {name: ^New$}}
  outputs:
    - template: templates/registry.go.tmpl
      path: "{{ .Options.out }}/registry.gen.go"
generators:
  store:
    description: Add a store
    inputs:
      name: {pattern: "^[a-z]+$", unique: Stores.Package}
    files:
      - template: templates/store.go.tmpl
        path: "{{ index .Options.dirs 0 | trimSuffix \"/*\" }}/{{ .Inputs.name }}/{{ .Inputs.name }}.go"
-- pack/templates/registry.go.tmpl --
package {{ .Options.package }}

// Stores: {{ range .Stores }}{{ storeTitle .Package }} {{ end }}
-- pack/templates/store.go.tmpl --
package {{ .Inputs.name }}

// New returns the {{ storeTitle .Inputs.name }} store.
func New() {}
-- v1.1/registry.go.tmpl --
package {{ .Options.package }}

// Stores ({{ len .Stores }}): {{ range .Stores }}{{ storeTitle .Package }} {{ end }}
-- repo-a/tools/adder/main.go --
package main

import (
	"typhonhill.dev/adder"

	store "example.com/storepack"
)

func main() { adder.Main(store.Pack) }
-- repo-a/adder.yaml --
version: 1
packs:
  stores:
    pack: store
    with: {dirs: ["stores/*"], out: registry}
-- repo-a/stores/disk/disk.go --
package disk

func New() {}
-- repo-b/tools/adder/main.go --
package main

import (
	"typhonhill.dev/adder"

	store "example.com/storepack"
)

func main() { adder.Main(store.Pack) }
-- repo-b/adder.yaml --
version: 1
packs:
  backends:
    pack: store
    with: {dirs: ["internal/backends/*"], out: internal/registry, package: backends}
    rename: {store: backend}
-- repo-b/internal/backends/s3/s3.go --
package s3

func New() {}
-- want/a-1.0.gen.go --
// Code generated by adder from templates/registry.go.tmpl in pack store for stores. DO NOT EDIT.

package registry

// Stores: Disk
-- want/b-1.0.gen.go --
// Code generated by adder from templates/registry.go.tmpl in pack store for backends. DO NOT EDIT.

package backends

// Stores: Gcs S3
-- want/a-1.1.gen.go --
// Code generated by adder from templates/registry.go.tmpl in pack store for stores. DO NOT EDIT.

package registry

// Stores (2): Disk Mem
