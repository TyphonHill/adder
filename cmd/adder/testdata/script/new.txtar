 	"mem":   mem.New,
-- missing.err --
adder: --name is required [missing-input]
	hint: Driver name, used as the package name
-- invalid.err --
adder: --name "Bad" does not match [a-z][a-z0-9]* [invalid-input]
	hint: Driver name, used as the package name
-- unique.err --
adder: --name "s3" already exists in Drivers.Package [invalid-input]
	hint: Driver name, used as the package name
-- unknown.err --
adder: unknown generator "drivr" [unknown-generator]
	hint: did you mean driver?
-- flag.err --
adder: unknown flag: --nope
Run 'adder new driver --help' for usage.
-- want/gcs.go --
// Package gcs is a driver that stores objects. Licensed under Apache-2.0.
package gcs

import "example.com/storage/driver"

// New returns a gcs driver.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }
-- inputs.json --
{"name": "mem", "summary": "keeps objects in memory"}
-- adder.yaml --
version: 1
vars:
  License: Apache-2.0
derive:
  scans:
    Drivers:
      dirs: ["drivers/*"]
      funcs:
        exported: true
        name: ^New$
  outputs:
    - template: templates/drivers.go.tmpl
      path: drivers/drivers.gen.go
generators:
  driver:
    description: Add a storage driver
    inputs:
      name:
        help: Driver name, used as the package name
        pattern: "[a-z][a-z0-9]*"
        unique: Drivers.Package
      summary:
        help: One-line description for the package documentation
        default: stores objects
      cache:
        type: bool
        help: Add an in-memory cache in front of the driver
    files:
      - template: templates/new/driver.go.tmpl
        path: drivers/{{ .Inputs.name }}/{{ .Inputs.name }}.go
      - template: templates/new/cache.go.tmpl
        path: drivers/{{ .Inputs.name }}/cache.go
        when: cache
      - template: templates/new/README.md.tmpl
        path: drivers/README.md
        ifExists: skip
    message: |
      Next, implement New in drivers/{{ .Inputs.name }}/{{ .Inputs.name }}.go.
-- driver/driver.go --
package driver

// Driver stores and retrieves objects.
type Driver interface {
	Get(key string) ([]byte, error)
}

// Factory creates a Driver from its configuration.
type Factory func(config map[string]string) (Driver, error)
-- drivers/local/local.go --
package local

import "example.com/storage/driver"

// New returns a driver backed by the local filesystem.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }

// NewOptions is not a constructor and is not registered.
func NewOptions() {}
-- drivers/s3/s3.go --
package s3

import "example.com/storage/driver"

// New returns a driver backed by an S3 bucket.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }

func newClient() {}
-- go.mod --
module example.com/storage

go 1.26.0
-- templates/drivers.go.tmpl --
package drivers

import (
	"{{ .Module }}/driver"
{{- range .Drivers }}
	"{{ .ImportPath }}"
{{- end }}
)

// All maps each driver name to its constructor.
var All = map[string]driver.Factory{
{{- range .Drivers }}
	"{{ .Package }}": {{ .Package }}.New,
{{- end }}
}
-- templates/new/README.md.tmpl --
# Drivers

Each directory holds one driver.
-- templates/new/cache.go.tmpl --
package {{ .Inputs.name }}

type cache struct{ entries map[string][]byte }
-- templates/new/driver.go.tmpl --
// Package {{ .Inputs.name }} is a driver that {{ .Inputs.summary }}. Licensed under {{ .Vars.License }}.
package {{ .Inputs.name }}

import "{{ .Module }}/driver"

// New returns a {{ .Inputs.name }} driver.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }
