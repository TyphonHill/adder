# Generators are listed when none is named.
exec adder new
cmp stdout list.out

# --dry-run plans the new files and the registry update without writing.
exec adder new driver --name gcs --dry-run
cmp stdout dryrun.out
! exists drivers/gcs

# A generator creates its files, updates the registry, and prints its message.
exec adder new driver --name gcs --cache
cmp stdout new.out
cmp drivers/gcs/gcs.go want/gcs.go
exists drivers/gcs/cache.go
exec adder check

# Inputs can come from standard input as JSON, and existing files marked skip are left alone.
stdin inputs.json
exec adder new driver --inputs -
cmp stdout stdin.out
grep 'driver that keeps objects in memory' drivers/mem/mem.go

# --diff shows new files as additions from /dev/null.
exec adder new driver --name blob --diff
cmp stdout diff.out
! exists drivers/blob

# Invocation mistakes exit with status 2.
exits 2 adder new driver
cmp stderr missing.err
exits 2 adder new driver --name Bad
cmp stderr invalid.err
exits 2 adder new driver --name s3
cmp stderr unique.err
exits 2 adder new drivr
cmp stderr unknown.err
exits 2 adder new driver --name x --nope
cmp stderr flag.err

# A file that already exists exits with status 1 and nothing is written.
mkdir drivers/taken
cp want/gcs.go drivers/taken/taken.go
exits 1 adder new driver --name taken
stderr '^drivers[/\\]taken[/\\]taken\.go: file already exists \[file-exists\]$'
! exists drivers/taken/cache.go

-- list.out --
new creates files from a generator declared under generators in adder.yaml.

Each generator is a subcommand with a flag for each of its inputs. Run 'adder new' to list the
generators and 'adder new <generator> --help' to see its inputs. Existing files are never overwritten,
and derived outputs are updated in the same run.

Usage:
  adder new <generator> [flags]
  adder new [command]

Available Commands:
  driver      Add a storage driver

Flags:
  -h, --help   help for new

Global Flags:
  -c, --config string   configuration file (default <root>/adder.yaml)
      --json            print the result and any problems as one JSON object on standard output
      --root string     repository root that scans and outputs are relative to (default: the directory holding adder.yaml, found from the current directory)

Use "adder new [command] --help" for more information about a command.
