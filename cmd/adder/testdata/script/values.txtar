# A constant scan drives an enum's String method and its list in declaration order, and variables marked with a
# directive become a list.
exec adder derive
cmp color/color_string.gen.go want/color_string.gen.go
cmp settings.md want/settings.md
exec adder check

-- adder.yaml --
version: 1
derive:
  scans:
    Colors:
      dirs: [color]
      values: {kind: const, type: Color}
    Settings:
      dirs: [color]
      values: {kind: var, directive: setting}
  outputs:
    - template: string.go.tmpl
      path: color/color_string.gen.go
    - template: settings.md.tmpl
      path: settings.md
-- go.mod --
module example.com/app

go 1.26.0
-- color/color.go --
package color

// Color is a color.
type Color int

// Colors, in the order they are drawn.
const (
	Red Color = iota
	Green
	Blue
)

// Size is not a color.
const Size = 3

// Default is the color when none is set.
//
//adder:setting
var Default = Red

var internal = Blue
-- string.go.tmpl --
package color

import "strconv"

func (c Color) String() string {
	switch c {
{{- range .Colors }}
	case {{ .Name }}:
		return {{ quote .Name }}
{{- end }}
	}
	return "Color(" + strconv.Itoa(int(c)) + ")"
}

// All lists the colors in the order they are declared.
var All = []Color{
{{- range sortBy "Iota" .Colors }}
	{{ .Name }},
{{- end }}
}
-- settings.md.tmpl --
{{ range .Settings }}- {{ .Name }} = {{ .Value }}: {{ .Doc }}
{{ end -}}
-- want/color_string.gen.go --
// Code generated by adder from string.go.tmpl. DO NOT EDIT.

package color

import "strconv"

func (c Color) String() string {
	switch c {
	case Blue:
		return "Blue"
	case Green:
		return "Green"
	case Red:
		return "Red"
	}
	return "Color(" + strconv.Itoa(int(c)) + ")"
}

// All lists the colors in the order they are declared.
var All = []Color{
	Red,
	Green,
	Blue,
}
-- want/settings.md --
<!-- Code generated by adder from settings.md.tmpl. DO NOT EDIT. -->
- Default = Red: Default is the color when none is set.
