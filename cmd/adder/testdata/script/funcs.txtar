# Files no platform can build are skipped, custom tags count only when listed, and the new functions render.
exec adder derive
cmp drivers.md want.md

# Listing the custom tag scans the integration driver too.
cp tagged.yaml adder.yaml
exec adder derive
grep '^- integration \(1 driver\)$' drivers.md

-- adder.yaml --
version: 1
derive:
  scans:
    Drivers:
      dirs: ["drivers/**"]
      funcs: {exported: true, name: ^New}
  outputs:
    - template: drivers.md.tmpl
      path: drivers.md
-- tagged.yaml --
version: 1
derive:
  scans:
    Drivers:
      dirs: ["drivers/**"]
      funcs: {exported: true, name: ^New}
      buildTags: [integration]
  outputs:
    - template: drivers.md.tmpl
      path: drivers.md
-- drivers.md.tmpl --
# {{ len .Drivers }} {{ plural "driver" "drivers" (len .Drivers) }}

{{ range groupBy "Package" .Drivers -}}
- {{ .Key }} ({{ len .Items }} {{ plural "driver" "drivers" (len .Items) }})
{{ end -}}
Constructors: {{ fieldValues "Name" .Drivers | join ", " }}
Quoted: {{ quote (trimSuffix "Store" (trimPrefix "New" "NewDiskStore")) }}
Config:{{ nindent 2 (replace ", " "\n" "a: 1, b: 2") }}
-- drivers/disk/disk.go --
package disk

func NewDiskStore() {}

func NewDiskCache() {}
-- drivers/linux/linux.go --
//go:build linux

package linux

func NewLinux() {}
-- drivers/old/old.go --
//go:build ignore

package old

func NewOld() {}
-- drivers/integration/integration.go --
//go:build integration

package integration

func NewIntegration() {}
-- want.md --
<!-- Code generated by adder from drivers.md.tmpl. DO NOT EDIT. -->
# 3 drivers

- disk (2 drivers)
- linux (1 driver)
Constructors: NewDiskCache, NewDiskStore, NewLinux
Quoted: "Disk"
Config:
  a: 1
  b: 2
