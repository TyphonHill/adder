# derive writes the registry, and check then finds nothing stale.
exec adder derive
cmp stdout derive.out
! stderr .
cmp drivers/drivers.gen.go want/drivers.gen.go
exec adder check
! stdout .
! stderr .

# Running derive again leaves the unchanged registry alone and prints nothing, unless asked.
exec adder derive
! stdout .
exec adder derive --verbose
stdout '^unchanged  drivers/drivers.gen.go$'
stdout '^scanned    scan Drivers found 2 items$'

# A new driver makes the registry stale, and check exits with status 3.
mkdir drivers/gcs
cp gcs.go drivers/gcs/gcs.go
exits 3 adder check
cmp stdout check.out
cmp stderr check.err

# --diff prints a patch and writes nothing.
exec adder derive --diff
cmp stdout diff.out
exits 3 adder check

# --dry-run lists the changes without writing them.
exec adder derive --dry-run
cmp stdout dryrun.out
exits 3 adder check

# Commands find adder.yaml from any directory below it.
cd drivers/s3
exec adder derive
cmp stdout ../../derive-gcs.out
exec adder check

# --out writes the outputs somewhere else for a preview.
cd $WORK
exec adder derive --out preview
cmp stdout preview.out
exists preview/drivers/drivers.gen.go

-- derive.out --
created    drivers/drivers.gen.go
-- want/drivers.gen.go --
// Code generated by adder from templates/drivers.go.tmpl. DO NOT EDIT.

package drivers

import (
	"example.com/storage/driver"
	"example.com/storage/drivers/local"
	"example.com/storage/drivers/s3"
)

// All maps each driver name to its constructor.
var All = map[string]driver.Factory{
	"local": local.New,
	"s3":    s3.New,
}
-- check.out --
would be updated    drivers/drivers.gen.go
-- check.err --
adder: 1 derived file is out of date; run 'adder derive' to update it
-- diff.out --
would be updated    drivers/drivers.gen.go

diff a/drivers/drivers.gen.go b/drivers/drivers.gen.go
--- a/drivers/drivers.gen.go
+++ b/drivers/drivers.gen.go
@@ -4,6 +4,7 @@
 
 import (
 	"example.com/storage/driver"
+	"example.com/storage/drivers/gcs"
 	"example.com/storage/drivers/local"
 	"example.com/storage/drivers/s3"
 )
@@ -10,6 +11,7 @@
 
 // All maps each driver name to its constructor.
 var All = map[string]driver.Factory{
+	"gcs":   gcs.New,
 	"local": local.New,
 	"s3":    s3.New,
 }
-- dryrun.out --
would be updated    drivers/drivers.gen.go
-- derive-gcs.out --
updated    drivers/drivers.gen.go
-- preview.out --
created    drivers/drivers.gen.go
-- gcs.go --
package gcs

import "example.com/storage/driver"

// New returns a driver backed by a Google Cloud Storage bucket.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }
-- adder.yaml --
version: 1
vars:
  License: Apache-2.0
derive:
  scans:
    Drivers:
      dirs: ["drivers/*"]
      funcs:
        exported: true
        name: ^New$
  outputs:
    - template: templates/drivers.go.tmpl
      path: drivers/drivers.gen.go
generators:
  driver:
    description: Add a storage driver
    inputs:
      name:
        help: Driver name, used as the package name
        pattern: "[a-z][a-z0-9]*"
        unique: Drivers.Package
      summary:
        help: One-line description for the package documentation
        default: stores objects
      cache:
        type: bool
        help: Add an in-memory cache in front of the driver
    files:
      - template: templates/new/driver.go.tmpl
        path: drivers/{{ .Inputs.name }}/{{ .Inputs.name }}.go
      - template: templates/new/cache.go.tmpl
        path: drivers/{{ .Inputs.name }}/cache.go
        when: cache
      - template: templates/new/README.md.tmpl
        path: drivers/README.md
        ifExists: skip
    message: |
      Next, implement New in drivers/{{ .Inputs.name }}/{{ .Inputs.name }}.go.
-- go.mod --
module example.com/storage

go 1.26.0
-- driver/driver.go --
package driver

// Driver stores and retrieves objects.
type Driver interface {
	Get(key string) ([]byte, error)
}

// Factory creates a Driver from its configuration.
type Factory func(config map[string]string) (Driver, error)
-- drivers/local/local.go --
package local

import "example.com/storage/driver"

// New returns a driver backed by the local filesystem.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }

// NewOptions is not a constructor and is not registered.
func NewOptions() {}
-- drivers/s3/s3.go --
package s3

import "example.com/storage/driver"

// New returns a driver backed by an S3 bucket.
func New(config map[string]string) (driver.Driver, error) { return nil, nil }

func newClient() {}
-- templates/drivers.go.tmpl --
package drivers

import (
	"{{ .Module }}/driver"
{{- range .Drivers }}
	"{{ .ImportPath }}"
{{- end }}
)

// All maps each driver name to its constructor.
var All = map[string]driver.Factory{
{{- range .Drivers }}
	"{{ .Package }}": {{ .Package }}.New,
{{- end }}
}
