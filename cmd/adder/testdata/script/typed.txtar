# A type-aware scan lists every type that implements an interface, with .Pointer for pointer receivers.
exec adder derive
cmp registry/registry.gen.go want/registry.gen.go

# A new driver is type checked before it is written, so the registry gains it in the same run.
exec adder new driver --name cache
stdout '^updated    registry/registry.gen.go$'
grep '&cache.Driver\{\},' registry/registry.gen.go
exec adder check

# Code that does not type check is a type-check problem at its position.
cp broken.go drivers/disk/broken.go
exits 1 adder derive
stderr '^drivers[/\\]disk[/\\]broken\.go:3:23: cannot use .* \[type-check\]$'

-- adder.yaml --
version: 1
derive:
  scans:
    Drivers:
      dirs: ["drivers/*"]
      typeCheck: true
      types: {implements: example.com/store/driver.Driver}
  outputs:
    - template: registry.go.tmpl
      path: registry/registry.gen.go
generators:
  driver:
    inputs:
      name: {pattern: "[a-z]+"}
    files:
      - template: new.go.tmpl
        path: "drivers/{{ .Inputs.name }}/{{ .Inputs.name }}.go"
-- go.mod --
module example.com/store

go 1.26.0
-- driver/driver.go --
package driver

// Driver stores objects.
type Driver interface{ Get(key string) ([]byte, error) }
-- drivers/disk/disk.go --
package disk

// Driver keeps objects on disk.
type Driver struct{}

func (Driver) Get(string) ([]byte, error) { return nil, nil }

// Options is not a driver.
type Options struct{}
-- drivers/s3/s3.go --
package s3

// Driver keeps objects in a bucket, through a pointer.
type Driver struct{ bucket string }

func (d *Driver) Get(string) ([]byte, error) { return nil, nil }
-- registry.go.tmpl --
package registry

import (
	"example.com/store/driver"
{{- range .Drivers }}
	"{{ .ImportPath }}"
{{- end }}
)

// All lists every driver.
var All = []driver.Driver{
{{- range .Drivers }}
	{{ if .Pointer }}&{{ end }}{{ .Package }}.{{ .Name }}{},
{{- end }}
}
-- new.go.tmpl --
package {{ .Inputs.name }}

// Driver is a new driver.
type Driver struct{}

func (*Driver) Get(string) ([]byte, error) { return nil, nil }
-- broken.go --
package disk

func F() int { return "x" }
-- want/registry.gen.go --
// Code generated by adder from registry.go.tmpl. DO NOT EDIT.

package registry

import (
	"example.com/store/driver"
	"example.com/store/drivers/disk"
	"example.com/store/drivers/s3"
)

// All lists every driver.
var All = []driver.Driver{
	disk.Driver{},
	&s3.Driver{},
}
