# An output with each writes one file per item, with adder's header, and other file types get theirs too.
exec adder derive
cmp stdout derive.out
cmp stores/memory/memory_mock.gen.go testdata/memory_mock.gen.go
cmp deploy/stores.yaml testdata/stores.yaml
exec adder check

# A handwritten file matching the path, but not produced for any item, is never touched.
cp handwritten.go stores/disk/extra_mock.gen.go

# Removing a store makes its mock stale: check exits with status 3 and --diff shows the deletion.
rm stores/memory/memory.go
exits 3 adder check --diff
cmp stdout check.out

# derive removes the stale file and keeps the handwritten one.
exec adder derive
cmp stdout removed.out
! exists stores/memory/memory_mock.gen.go
exists stores/disk/extra_mock.gen.go
exec adder check

# A new item whose file already exists, written by hand, is refused and nothing is written.
mkdir stores/cache
cp cache.go stores/cache/cache.go
cp handwritten.go stores/cache/cache_mock.gen.go
exits 1 adder derive
stderr '^stores[/\\]cache[/\\]cache_mock\.gen\.go: file already exists and adder did not generate it, so it is not replaced by templates/mock\.go\.tmpl \[file-exists\]$'
grep 'written by hand' stores/cache/cache_mock.gen.go
rm stores/cache

# JSON reports removals with their own status.
cp memory.go stores/memory/memory.go
exec adder derive
rm stores/memory/memory.go
exec adder derive --dry-run --json
stdout '"path": "stores/memory/memory_mock.gen.go",\n      "status": "removed"'

-- adder.yaml --
version: 1
derive:
  scans:
    Stores:
      dirs: ["stores/*"]
      funcs: {exported: true, name: ^New$}
  outputs:
    - template: templates/mock.go.tmpl
      each: Stores
      path: "{{ .Item.Dir }}/{{ .Item.Package }}_mock.gen.go"
    - template: templates/stores.yaml.tmpl
      path: deploy/stores.yaml
-- go.mod --
module example.com/app

go 1.26.0
-- stores/memory/memory.go --
package memory

// New returns an in-memory store.
func New() any { return nil }
-- stores/s3/s3.go --
package s3

// New returns a store backed by S3.
func New() any { return nil }
-- stores/disk/disk.go --
package disk

// New returns a store on local disk.
func New() any { return nil }
-- templates/mock.go.tmpl --
package {{ .Item.Package }}

// Mock stands in for the store {{ .Item.Package }}.New returns, one of {{ len .Stores }}.
type Mock struct{}
-- templates/stores.yaml.tmpl --
stores:
{{- range .Stores }}
  - {{ .Package }}
{{- end }}
-- memory.go --
package memory

// New returns an in-memory store.
func New() any { return nil }
-- cache.go --
package cache

// New returns a cache.
func New() any { return nil }
-- handwritten.go --
package disk

// Mock is written by hand.
type Mock struct{}
-- derive.out --
created    stores/disk/disk_mock.gen.go
created    stores/memory/memory_mock.gen.go
created    stores/s3/s3_mock.gen.go
created    deploy/stores.yaml
-- check.out --
would be updated    stores/disk/disk_mock.gen.go
would be updated    stores/s3/s3_mock.gen.go
would be removed    stores/memory/memory_mock.gen.go
would be updated    deploy/stores.yaml

diff a/stores/disk/disk_mock.gen.go b/stores/disk/disk_mock.gen.go
--- a/stores/disk/disk_mock.gen.go
+++ b/stores/disk/disk_mock.gen.go
@@ -2,5 +2,5 @@
 
 package disk
 
-// Mock stands in for the store disk.New returns, one of 3.
+// Mock stands in for the store disk.New returns, one of 2.
 type Mock struct{}

diff a/stores/s3/s3_mock.gen.go b/stores/s3/s3_mock.gen.go
--- a/stores/s3/s3_mock.gen.go
+++ b/stores/s3/s3_mock.gen.go
@@ -2,5 +2,5 @@
 
 package s3
 
-// Mock stands in for the store s3.New returns, one of 3.
+// Mock stands in for the store s3.New returns, one of 2.
 type Mock struct{}

diff a/stores/memory/memory_mock.gen.go /dev/null
--- a/stores/memory/memory_mock.gen.go
+++ /dev/null
@@ -1,6 +0,0 @@
-// Code generated by adder from templates/mock.go.tmpl. DO NOT EDIT.
-
-package memory
-
-// Mock stands in for the store memory.New returns, one of 3.
-type Mock struct{}

diff a/deploy/stores.yaml b/deploy/stores.yaml
--- a/deploy/stores.yaml
+++ b/deploy/stores.yaml
@@ -1,5 +1,4 @@
 # Code generated by adder from templates/stores.yaml.tmpl. DO NOT EDIT.
 stores:
   - disk
-  - memory
   - s3
-- removed.out --
updated    stores/disk/disk_mock.gen.go
updated    stores/s3/s3_mock.gen.go
removed    stores/memory/memory_mock.gen.go
updated    deploy/stores.yaml
-- testdata/memory_mock.gen.go --
// Code generated by adder from templates/mock.go.tmpl. DO NOT EDIT.

package memory

// Mock stands in for the store memory.New returns, one of 3.
type Mock struct{}
-- testdata/stores.yaml --
# Code generated by adder from templates/stores.yaml.tmpl. DO NOT EDIT.
stores:
  - disk
  - memory
  - s3
